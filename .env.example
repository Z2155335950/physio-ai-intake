LLM_PROVIDER=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_CONNECT_TIMEOUT_SECONDS=8
LLM_READ_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1800
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=300
# Keep false to redact names, phones and addresses before PDF text reaches AI.
LLM_SEND_PII=false

KNOWLEDGE_DIR=./data/knowledge
KNOWLEDGE_POLICY_FILE=./data/knowledge_policy.json
CUSTOMER_DB_PATH=./data/customer_memory.sqlite3
TOOL_AUDIT_DB_PATH=./data/tool_audit.sqlite3
TOOL_ACTOR_ID=local-therapist
LOW_SESSION_THRESHOLD=2
RISK_LOOKBACK_DAYS=30
# Empty uses <CUSTOMER_DB_PATH directory>/backups
BACKUP_DIR=
BACKUP_AUTO_ENABLED=true
# Required for automatic daily backups and restore rollback backups.
# All new backups are AES-GCM encrypted; empty prevents new automatic/rollback backups.
BACKUP_AUTO_PASSWORD=
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_TTL_MINUTES=10
# These values are shown before customer registration and stored with consent.
PRIVACY_POLICY_VERSION=2026-11-15-v1
PRIVACY_PURPOSE=用于建立和管理客户档案，安排预约、接诊与复诊，提供顾客网页查询，并用于加密备份、安全审计和服务质量改进；不用于广告营销。启用 AI 录入且经门店授权时，仅向模型发送去除姓名、电话和地址后的必要文本。
PRIVACY_RETENTION=在服务期间及最后一次业务联系后3年内保存；到期后删除或匿名化。法律法规、监管或争议处理另有要求时按要求延长。
PRIVACY_DELETION_RULE=可联系门店隐私联系人申请查询、更正、导出或删除个人资料。身份核验后删除账号、隐私同意记录、客户档案、接诊、预约、复诊和养护说明；系统内加密备份副本最迟在30天备份保留期结束后清理，另行导出的介质由门店按同一期限销毁并留痕。
# Required before customer registration. Use a real phone, email, WeChat, or responsible person.
PRIVACY_CONTACT=
# Set a long random password before exposing the staff APIs beyond localhost
STAFF_ACCESS_PASSWORD=
STAFF_ADMIN_USERNAME=admin
# Set true when the portal is served over HTTPS
PORTAL_COOKIE_SECURE=false

